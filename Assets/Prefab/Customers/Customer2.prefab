  in_anger:
  - "\u6211\u8EAB\u9AD4\u5F88\u7D50\u5BE6\u5594\uFF0C\u4F60\u6700\u597D\u5C0F\u5FC3\u9EDE\u3002"
  moodDialoguesHappy:
  - "\u611F\u89BA\u5230\u80CC\u808C\u5728\u8B8A\u5927\uFF01"
  - "\u6211\u7684\u808C\u8089\u5F88\u6027\u611F\u5427\u22EF\u22EF"
  - "\u597D\u60F3\u7528\u80F8\u808C\u593E\u73CD\u5976\u770B\u770B\uFF01"
  - "\u8840\u6DB2\u5FAA\u74B0\u597D\uFF0C\u808C\u8089\u624D\u6703\u767C\u9054\uFF01"
  - "\u55EF\uFF01\u8212\u670D\uFF01"
  - "\u5594\u5594\u5594\uFF01\u8840\u8108\u8CC1\u5F35\u5566\uFF01"
  - "\u518D\u7D66\u6211\u591A\u4E00\u9EDE\uFF01"
  - "\u6211\u73FE\u5728\u5145\u6EFF\u6C7A\u5FC3\uFF01"
  moodDialoguesAngry:
  - "\u4F60\u624B\u9577\u8E7C\u554A\uFF1F\u597D\u597D\u6309\uFF01"
  - "\u6211\u59E8\u5A46\u908A\u89C0\u843D\u9670\u908A\u6309\u90FD\u6BD4\u4F60\u6E96\u22EF\u22EF"
  - "\u4F60\u8981\u628A\u6211\u7684\u80CC\u95CA\u808C\u6309\u6563\u4E86\uFF01"
  - "\u52A0\u628A\u52C1\u597D\u55CE\uFF1F\u4E0D\u4E7E\u4E0D\u8106\u7684\uFF01"
  - "\u6211\u4E0D\u5982\u5728\u5065\u5EB7\u6B65\u9053\u4E0A\u6EFE\uFF01"
  - "\u6562\u4E0D\u6562\u518D\u4F86\uFF1F"
  - "\u4F60\u884C\u4E0D\u884C\u554A\uFF1F"
  - "\u5927\u529B\u4E00\u9EDE\uFF0C\u6C92\u5403\u98EF\u5594\uFF1F"
