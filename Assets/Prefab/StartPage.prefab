--- !u!114 &3332187675995630419
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2047565464975704653}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.8792453, g: 0.8792453, b: 0.8792453, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 22d83d25fdc6bef4791a7c51607a058b, type: 3}
    m_FontSize: 64
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 6
    m_MaxSize: 64
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\"\u4F60\u5929\u751F\u6148\u60B2\u70BA\u61F7\uFF0C\u9084\u6709\u526F\u5F97\u5929\u7368\u539A\u7684\u96D9\u638C\u3002\n\n\u5C0F\u6642\u5019\uFF0C\u8001\u5E2B\u8981\u6C42\u4F60\u5011\u8F2A\u6D41\u767C\u8868\u300C\u6211\u7684\u5922\u60F3\u300D\uFF0C\n\u7576\u4F60\u5EB8\u4FD7\u7684\u540C\u5B78\u9084\u5728\u5922\u60F3\u6210\u70BA\u7E3D\u7D71\u8B70\u54E1\u592A\u7A7A\u4EBA\uFF0C\n\u4F60\u5DF2\u63EE\u6BEB\u5728\u9ED1\u677F\u767C\u4E0B\u6FDF\u4E16\u5927\u9858\uFF1A\n\u4E0D\u8AD6\u4F86\u8005\u4F55\u4EBA\uFF0C\u4F60\u90FD\u6A02\u65BC\u7528\u4E0A\u84BC\u8D08\u4E88\u4F60\u7684\u624D\u83EF\uFF0C\n\u666E\u6E21\u5929\u4E0B\u84BC\u751F\uFF0C\u4EE4\u842C\u5343\u751F\u9748\u9AD4\u609F\u5FC3\u9748\u7965\u548C\u22EF\u22EF\n\n\u9577\u5927\u5F8C\u7684\u4F60\u5F97\u511F\u6240\u9858\uFF0C\u958B\u4E86\u4E00\u5BB6\u6309\u6469\u9928\u22EF\u22EF\"\r\n\"\u6210\u529F\u5F88\u96E3\uFF0C\u767D\u624B\u8D77\u5BB6\u5247\u662F\u96E3\u4E0A\u52A0\u96E3\u3002\n\n\u606D\u559C\u4F60\uFF0C\u4F60\u6B63\u662F\u6210\u529F\u767D\u624B\u8D77\u5BB6\u7684\u4EBA\u4E0A\u4EBA\u4E4B\u4E00\u3002\n\u4E0D\u904E\u76F8\u8F03\u5176\u4ED6\u4EBA\u9760\u6A5F\u904B\u6216\u4EBA\u8108\u8E8B\u8EAB\u4E0A\u6D41\uFF0C\n\u4F60\u53EF\u662F\u771F\u771F\u5207\u5207\u9760\u8EAB\u4E0A\u9019\u96D9\u638C\uFF0C\n\u5728\u7AF6\u722D\u6FC0\u70C8\u7684\u5E02\u5834\u95D6\u51FA\u540D\u865F\u3002\n\n\u9019\u9031\uFF0C\u4F60\u7D93\u71DF\u7684\u6309\u6469\u9928\u4F9D\u7136\u6709\u8A31\u591A\u4EBA\u6155\u540D\u800C\u4F86\u22EF\u22EF\"\r\n\"\u4ECA\u5929\u662F\u500B\u518D\u5E73\u51E1\u4E0D\u904E\u7684\u65E5\u5B50\uFF0C\n\u4F60\u6469\u62F3\u64E6\u638C\uFF0C\u7A7F\u4E0A\u5236\u670D\uFF0C\n\u7B49\u5F85\u6309\u6469\u5E97\u7684\u7B2C\u4E00\u500B\u5BA2\u4EBA\u22EF\u22EF\"\r\n\"\u64DA\u8AAA\u6309\u6469\u4E0D\u53EA\u80FD\u6D88\u9664\u8089\u9AD4\u7684\u75E0\u75DB\uFF0C\n\u9084\u6709\u66FF\u5FC3\u9748\u6392\u89E3\u6BD2\u7D20\u4E4B\u6548\u3002\n\n\u4F46\u4E00\u4ECB\u666E\u901A\u4EBA\u5982\u4F60\u7576\u7136\u4E0D\u5728\u4E4E\u9019\u4E9B\uFF0C\n\u4F60\u89AC\u89A6\u7684\u53EA\u662F\u9867\u5BA2\u7D66\u7684\u5DE8\u984D\u5C0F\u8CBB\u2014\u2014\n\u53EA\u8981\u6EAB\u67D4\u5730\u6469\u5A11\u9867\u5BA2\u7D50\u5BE6\u7684\u8089\u9AD4\uFF0C\n\u7CBE\u6E96\u64AB\u5E73\u4ED6\u5011\u5167\u5FC3\u7684\u7126\u8E81\uFF0C\n\u4EBA\u5011\u559C\u5B5C\u5B5C\u905E\u4F86\u7684\u9214\u7968\u8DB3\u4EE5\u8CBC\u88DC\u4F60\u5C11\u5F97\u53EF\u6190\u7684\u85AA\u8CC7\u3002\n\n\u4ECA\u5929\u7684\u4F60\u4E5F\u5728\u6399\u9322\uFF0C\n\u70BA\u5378\u9664\u591A\u9918\u7684\u60C5\u7DD2\uFF0C\u4EE5\u53CA\u7D13\u7DE9\u7DCA\u7E43\u7684\u80F4\u9AD4\u800C\u52AA\u529B\u3002\""
